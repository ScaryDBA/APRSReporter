view "reports"."points_geojson" {
  text = """-
SELECT jsonb_build_object('type', 'FeatureCollection', 'features', jsonb_agg(jsonb_build_object('type', 'Feature', 'geometry', (public.st_asgeojson((gis_point)::public.geometry))::jsonb, 'properties', jsonb_build_object('time', lasttime, 'speed', actual_speed_kmh, 'altitude', altitude, 'distance', distance_from_previous)) ORDER BY lasttime)) AS geojson
   FROM reports.location_info
  WHERE (loc_name = 'KC1KCE-8'::text);
"""
  owner = postgres
  columns = (
    column "geojson" {
      type = jsonb
    }
  )
}

