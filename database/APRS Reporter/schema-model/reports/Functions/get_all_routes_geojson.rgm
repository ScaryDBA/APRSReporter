function "reports"."get_all_routes_geojson()" {
  text = """

BEGIN
    -- Use journey detection instead of date-based grouping
    RETURN reports.get_recent_journeys_geojson('KC1KCE-8', 10, 1.0);
END;
"""
  returnType = jsonb
  arguments = [
  ]
  language = plpgsql
  owner = postgres
  comment = Returns recent journeys (uses journey detection with 1-hour gaps)
}

function "reports"."get_all_routes_geojson(date)" {
  text = """

BEGIN
    -- Use journey detection instead of date-based grouping
    -- Limit to 10 most recent journeys, optionally filtered by date
    RETURN reports.get_recent_journeys_geojson('KC1KCE-8', 10, 1.0, p_date);
END;
"""
  returnType = jsonb
  arguments = <
    {
      name = p_date
      type = date
      mode = IN
      default = NULL::date
    }

  >
  language = plpgsql
  owner = gis_admin
}

